# ========================================================
# ARCHIVO DE CONFIGURACION DE TELEGRAM (.env)
# ========================================================
# Renombra este archivo a ".env" para activar el envio real a Telegram.
#
# Pasos para obtener tu TOKEN:
# 1. Abre Telegram y busca a @BotFather
# 2. Envia el comando /newbot y sigue las instrucciones para crear tu bot.
# 3. BotFather te dara un TOKEN (ej: 7123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ).
#
# Pasos para obtener tu CHAT ID:
# 1. Inicia conversacion con tu bot recien creado (presiona Start / Iniciar).
# 2. Busca a @userinfobot en Telegram y dale Start; te dira tu "Id" numerico (ej: 123456789).
# 3. Puedes usar el script "python src/test_telegram.py" para autodetectar y verificar.

# OPCION 1: Mismo Bot y Chat para los 4 clientes (recomendado para pruebas rapidas):
# TELEGRAM_TOKEN_DEFAULT=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID_DEFAULT=123456789

# OPCION 2: Cuatro bots independientes (especificacion exacta del profesor):
BOT_1_TOKEN=TOKEN_BOT_1
BOT_1_CHAT_ID=CHAT_ID_1

BOT_2_TOKEN=TOKEN_BOT_2
BOT_2_CHAT_ID=CHAT_ID_2

BOT_3_TOKEN=TOKEN_BOT_3
BOT_3_CHAT_ID=CHAT_ID_3

BOT_4_TOKEN=TOKEN_BOT_4
BOT_4_CHAT_ID=CHAT_ID_4

# Parametros de Broker MQTT (por defecto Mosquitto local):
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Intervalo de envio en segundos (pauta oficial = 5)
INTERVALO_PUBLICACION=5.0
