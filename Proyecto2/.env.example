# Configuracion de variables de entorno para Telegram y MQTT
# Copia este archivo con el nombre ".env" y completa tus tokens de BotFather

# 4 Bots de Telegram (segun especificacion de la pauta)
BOT_1_TOKEN=
BOT_1_CHAT_ID=

BOT_2_TOKEN=
BOT_2_CHAT_ID=

BOT_3_TOKEN=
BOT_3_CHAT_ID=

BOT_4_TOKEN=
BOT_4_CHAT_ID=

# Parametros del Broker MQTT Mosquitto
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Intervalo de publicacion de datos en segundos (pauta oficial = 5)
INTERVALO_PUBLICACION=5.0
